#pragma kernel CSMain
#pragma kernel CSAtlas

#include "OklabConverter.hlsl"

// ============================================
// 共通変数
// ============================================
RWTexture2D<float4> _Source;
RWTexture2D<float4> _Target;

// ============================================
// 色変換パラメータ
// ============================================
int _TransformMode;          // 0=Gradient, 1=HueShift, 2=RGBDelta
int _HueShiftAlgorithm;      // 0=HSV, 1=Oklab
float3 _TargetColorHSV;      // ターゲット色（HSV、HSV algorithm 用）
float _SaturationPreserve;   // 彩度保持率（HSV algorithm 用）
float _ValuePreserve;        // 明度保持率（HSV algorithm 用）

// Oklab algorithm 用
float4 _TargetColorOklch;    // (L, C, h_radians, _)
float _OklabHueRetain;
float _OklabSaturationToTarget;
float _OklabLToTarget;
float _OklabLDarkEndRatio;
float _OklabSourceLP95;
float _OklabSourceLP05;
float _OklabSourceHDominant;

// RGBDelta モード用
float4 _RgbDeltaLinear;      // (dr, dg, db, _) 線形空間での差分（intensity 適用済み）
float _RgbDeltaSoftClipZone;

// グラデーション用
RWTexture2D<float4> _GradientTexture;
int _GradientResolution;

// ============================================
// アトラス生成パラメータ
// ============================================
float2 _AtlasOffset;
float2 _AtlasScale;
float _AtlasRotation;
int2 _SourceSize;
int2 _TargetSize;

// ============================================
// HSV ユーティリティ
// ============================================

float3 RGBtoHSV(float3 rgb)
{
    float4 K = float4(0.0, -1.0 / 3.0, 2.0 / 3.0, -1.0);
    float4 p = lerp(float4(rgb.bg, K.wz), float4(rgb.gb, K.xy), step(rgb.b, rgb.g));
    float4 q = lerp(float4(p.xyw, rgb.r), float4(rgb.r, p.yzx), step(p.x, rgb.r));

    float d = q.x - min(q.w, q.y);
    float e = 1.0e-10;
    return float3(abs(q.z + (q.w - q.y) / (6.0 * d + e)), d / (q.x + e), q.x);
}

float3 HSVtoRGB(float3 hsv)
{
    float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
    float3 p = abs(frac(hsv.xxx + K.xyz) * 6.0 - K.www);
    return hsv.z * lerp(K.xxx, saturate(p - K.xxx), hsv.y);
}

float GetLuminance(float3 rgb)
{
    return dot(rgb, float3(0.299, 0.587, 0.114));
}

// ============================================
// 色変換ロジック
// ============================================

float3 TransformGradient(float3 rgb)
{
    float luminance = GetLuminance(rgb);
    int gradientX = (int)(luminance * (_GradientResolution - 1));
    gradientX = clamp(gradientX, 0, _GradientResolution - 1);
    float4 gradientColor = _GradientTexture[int2(gradientX, 0)];
    return gradientColor.rgb;
}

float3 TransformHueShiftHSV(float3 rgb)
{
    float3 srcHSV = RGBtoHSV(rgb);
    float newH = _TargetColorHSV.x;
    float newS = lerp(_TargetColorHSV.y, srcHSV.y, _SaturationPreserve);
    float newV = lerp(_TargetColorHSV.z, srcHSV.z, _ValuePreserve);
    return HSVtoRGB(float3(newH, newS, newV));
}

float3 TransformHueShiftOklab(float3 srgb)
{
    // sRGB -> Oklab -> OKLCh
    float3 lin = SRGBToLinear(srgb);
    float3 lab = LinearRGBToOklab(lin);
    float3 lch = OklabToOklch(lab);

    float targetL = _TargetColorOklch.x;
    float targetC = _TargetColorOklch.y;
    float targetH = _TargetColorOklch.z;

    // L 補正: 線形リマップ
    // [source.L_p05, source.L_p95] → [target.L * darkEndRatio, target.L]
    float sourceRange = _OklabSourceLP95 - _OklabSourceLP05;
    float normalized = sourceRange > 1e-5 ? (lch.x - _OklabSourceLP05) / sourceRange : 0.5;
    float targetDarkL = targetL * _OklabLDarkEndRatio;
    float mappedL = lerp(targetDarkL, targetL, normalized);
    float newL = lerp(lch.x, mappedL, _OklabLToTarget);
    newL = SoftClip01(newL, 0.05);

    // C 補正: 元ピクセル彩度 → target.C へ直接 lerp
    float newC = max(0.0, lerp(lch.y, targetC, _OklabSaturationToTarget));

    // h 補正: 全ピクセルで target.h に統一（hueRetain>0 なら元色相との相対差を一部保持）
    // グレー判定分岐は撤廃。彩度が小さいピクセルに target.h を与えても、
    // C が小さければ色として見えないため破綻しない。
    float deltaH = WrapHueRadians(lch.z - _OklabSourceHDominant);
    float retained = deltaH * _OklabHueRetain;
    float newH = WrapHueRadians(targetH + retained);

    return OklchToSRGBGamutMapped(float3(newL, newC, newH));
}

float3 TransformRGBDelta(float3 srgb)
{
    float3 lin = SRGBToLinear(srgb);
    float3 shifted = lin + _RgbDeltaLinear.xyz;
    shifted.r = SoftClip01(shifted.r, _RgbDeltaSoftClipZone);
    shifted.g = SoftClip01(shifted.g, _RgbDeltaSoftClipZone);
    shifted.b = SoftClip01(shifted.b, _RgbDeltaSoftClipZone);
    return LinearToSRGB(shifted);
}

// ============================================
// 色変換カーネル
// ============================================
[numthreads(16, 16, 1)]
void CSMain(uint3 id : SV_DispatchThreadID)
{
    uint width, height;
    _Source.GetDimensions(width, height);
    if (id.x >= width || id.y >= height) return;

    float4 srcColor = _Source[id.xy];
    float3 rgb = srcColor.rgb;
    float alpha = srcColor.a;

    if (alpha < 0.001)
    {
        _Target[id.xy] = srcColor;
        return;
    }

    float3 resultRGB = rgb;

    if (_TransformMode == 0) // Gradient
    {
        resultRGB = TransformGradient(rgb);
    }
    else if (_TransformMode == 1) // HueShift
    {
        if (_HueShiftAlgorithm == 1) // Oklab
        {
            resultRGB = TransformHueShiftOklab(rgb);
        }
        else // HSV
        {
            resultRGB = TransformHueShiftHSV(rgb);
        }
    }
    else if (_TransformMode == 2) // RGBDelta
    {
        resultRGB = TransformRGBDelta(rgb);
    }

    _Target[id.xy] = float4(saturate(resultRGB), alpha);
}

// ============================================
// アトラス生成カーネル
// ============================================
[numthreads(16, 16, 1)]
void CSAtlas(uint3 id : SV_DispatchThreadID)
{
    int2 atlasPos = int2(
        (int)(_AtlasOffset.x * _TargetSize.x) + id.x,
        (int)(_AtlasOffset.y * _TargetSize.y) + id.y
    );

    int atlasWidth = (int)(_AtlasScale.x * _TargetSize.x);
    int atlasHeight = (int)(_AtlasScale.y * _TargetSize.y);

    if (id.x >= (uint)atlasWidth || id.y >= (uint)atlasHeight) return;
    if (atlasPos.x < 0 || atlasPos.x >= _TargetSize.x) return;
    if (atlasPos.y < 0 || atlasPos.y >= _TargetSize.y) return;

    float u = (float)id.x / atlasWidth;
    float v = (float)id.y / atlasHeight;

    if (abs(_AtlasRotation) > 0.001)
    {
        float rad = radians(-_AtlasRotation);
        float cosR = cos(rad);
        float sinR = sin(rad);
        float cu = u - 0.5;
        float cv = v - 0.5;
        u = cu * cosR - cv * sinR + 0.5;
        v = cu * sinR + cv * cosR + 0.5;
    }

    if (u < 0 || u > 1 || v < 0 || v > 1)
    {
        return;
    }

    int srcX = (int)(u * (_SourceSize.x - 1));
    int srcY = (int)(v * (_SourceSize.y - 1));
    srcX = clamp(srcX, 0, _SourceSize.x - 1);
    srcY = clamp(srcY, 0, _SourceSize.y - 1);

    float4 srcColor = _Source[int2(srcX, srcY)];
    _Target[atlasPos] = srcColor;
}
