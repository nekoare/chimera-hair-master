msgstr "Oklab"

# ---- Oklab parameters ----
msgid "Inspector:OklabHueRetain"
msgstr "Preserve original hue"

msgid "Inspector:OklabHueRetainTooltip"
msgstr "0 = lock hue to target / 1 = keep original hue nuances"

msgid "Inspector:OklabHelp"
msgstr "Oklab is a color space where luminance and chroma are independent, making it easier to automatically align the color of multiple textures to the target."

# ---- RGB Delta parameters ----
msgid "Inspector:RgbDeltaIntensity"
msgstr "Delta intensity"

msgid "Inspector:RgbDeltaIntensityTooltip"
msgstr "0 = no change / 1 = fully add the delta from the texture's representative color to the target"

msgid "Inspector:RgbDeltaSoftClipZone"
msgstr "Soft clip zone"

msgid "Inspector:RgbDeltaSoftClipZoneTooltip"
msgstr "Width of the soft asymptote near out-of-range values (measured in Linear RGB space). 0.05 is typical"

msgid "Inspector:RgbDeltaHelp"
msgstr "RGB Delta mode: adds the difference from the texture's representative color to the target across all pixels.\nHue is not forced so differences are preserved, retaining nuances such as highlights."

# ---- Blur / Sharpen ----
msgid "Inspector:BlurSharpAdjustment"
msgstr "Adjust paint detail"

msgid "Inspector:BlurSharpAdjustmentHelp"
msgstr "Negative values apply blur, positive values apply sharpen. Applied as preprocessing just before color transform.\nUse this to match the paint feel (crisp vs. soft) across textures."

# ---- Texture Export: mesh merge discard warning ----
